{
  "name": "tutien-combat-runtime-smoke",
  "description": "Launch the real Godot client in isolated QA mode, reach Luyen Khi through the canonical breakthrough action, open the Godot-first Combat screen, and verify canonical Combat DTO/event playback wiring.",
  "target": {
    "mode": "launch",
    "project_path": "../..",
    "headless": true,
    "timeout_ms": 60000
  },
  "steps": [
    {
      "name": "Home runtime starts",
      "action": "wait_for_node",
      "with": {
        "selector": "name:HomeHUD",
        "state": "visible",
        "timeout_ms": 15000
      }
    },
    {
      "name": "Canonical bridge reaches online",
      "action": "wait_for_property",
      "with": {
        "selector": "name:BridgeStatus",
        "property": "text",
        "operator": "contains",
        "expected_value": "ONLINE",
        "timeout_ms": 20000,
        "poll_interval_ms": 200
      }
    },
    {
      "with": {
        "property": "disabled",
        "expected": true,
        "selector": "name:CombatAction",
        "operator": "equals"
      },
      "action": "assert_property",
      "name": "Fresh Pham Nhan keeps Combat locked"
    },
    {
      "name": "Prepare canonical breakthrough fixture",
      "action": "press_key",
      "with": {
        "key": "F6"
      }
    },
    {
      "name": "Canonical breakthrough CTA appears",
      "action": "wait_for_node",
      "with": {
        "selector": "name:PrimaryCTA",
        "state": "visible",
        "timeout_ms": 10000
      }
    },
    {
      "name": "Perform canonical breakthrough",
      "action": "click",
      "with": {
        "selector": "name:PrimaryCTA"
      }
    },
    {
      "name": "Combat quick action unlocks at Luyen Khi",
      "action": "wait_for_property",
      "with": {
        "selector": "name:CombatAction",
        "property": "disabled",
        "operator": "equals",
        "expected_value": false,
        "timeout_ms": 15000,
        "poll_interval_ms": 200
      }
    },
    {
      "name": "Open Godot Combat",
      "action": "click",
      "with": {
        "selector": "name:CombatAction"
      }
    },
    {
      "name": "Godot Combat screen owns the route",
      "action": "wait_for_node",
      "with": {
        "selector": "name:CombatScreen",
        "state": "visible",
        "timeout_ms": 15000
      }
    },
    {
      "name": "Canonical challenge becomes available",
      "action": "wait_for_property",
      "with": {
        "selector": "name:CombatChallenge",
        "property": "disabled",
        "operator": "equals",
        "expected_value": false,
        "timeout_ms": 15000,
        "poll_interval_ms": 200
      }
    },
    {
      "name": "Combat HUD core exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:CombatPlayerHP",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Combat Dao widget exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:CombatDaoWidget",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Combat skill rail exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:CombatSkillRail",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Run canonical Boss combat",
      "action": "click",
      "with": {
        "selector": "name:CombatChallenge"
      }
    },
    {
      "name": "Canonical event playback reaches tactical lane",
      "action": "wait_for_property",
      "with": {
        "selector": "name:CombatTacticalLane",
        "property": "text",
        "operator": "not_equals",
        "expected_value": "CHỜ GIAO TRANH",
        "timeout_ms": 15000,
        "poll_interval_ms": 100
      }
    },
    {
      "name": "Combat route can return Home",
      "action": "click",
      "with": {
        "selector": "name:CombatBack"
      }
    },
    {
      "name": "Home returns after Combat",
      "action": "wait_for_node",
      "with": {
        "selector": "name:HomeStage",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "with": {
        "property": "_combat_polling",
        "selector": "name:BackendBridge",
        "operator": "equals",
        "expected_value": false,
        "timeout_ms": 10000
      },
      "action": "wait_for_property",
      "name": "Combat polling stops outside route"
    },
    {
      "with": {
        "selector": "name:CombatAction"
      },
      "action": "click",
      "name": "Reenter Combat"
    },
    {
      "with": {
        "property": "_combat_polling",
        "selector": "name:BackendBridge",
        "operator": "equals",
        "expected_value": true,
        "timeout_ms": 10000
      },
      "action": "wait_for_property",
      "name": "Reentry restarts polling"
    },
    {
      "with": {
        "property": "_combat_cursor",
        "expected_value": 0,
        "timeout_ms": 10000,
        "selector": "name:BackendBridge",
        "operator": "greater_than"
      },
      "action": "wait_for_property",
      "name": "Reentry fetches canonical snapshot and events"
    },
    {
      "with": {
        "selector": "name:CombatBack"
      },
      "action": "click",
      "name": "Leave Combat again"
    },
    {
      "name": "Second exit finishes before navigation",
      "action": "wait_for_property",
      "with": {
        "expected_value": false,
        "timeout_ms": 10000,
        "property": "_combat_polling",
        "selector": "name:BackendBridge",
        "operator": "equals"
      }
    },
    {
      "with": {
        "selector": "name:Nav_character"
      },
      "action": "click",
      "name": "Character navigation remains functional"
    },
    {
      "with": {
        "timeout_ms": 10000,
        "selector": "name:CharacterScreen",
        "state": "visible"
      },
      "action": "wait_for_node",
      "name": "Character renders after Combat"
    },
    {
      "with": {
        "selector": "name:Nav_home"
      },
      "action": "click",
      "name": "Return Home from Character"
    },
    {
      "name": "Scene tree remains inspectable",
      "action": "tree",
      "with": {
        "root_path": "/root",
        "max_depth": 5
      }
    }
  ]
}
