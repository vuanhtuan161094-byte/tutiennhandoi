{
  "name": "tutien-home-runtime-smoke",
  "description": "Launch the real Godot Home headlessly, verify canonical bridge connectivity, Home presentation modes, and progressive disclosure.",
  "target": {
    "mode": "launch",
    "project_path": "../..",
    "headless": true,
    "timeout_ms": 60000
  },
  "steps": [
    {
      "name": "Home stage exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:HomeStage",
        "state": "exists",
        "timeout_ms": 15000
      }
    },
    {
      "name": "Home meditation hero exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:HomeMeditationHero",
        "state": "visible",
        "timeout_ms": 15000
      }
    },
    {
      "name": "Home hero uses meditation pose",
      "action": "assert_property",
      "with": {
        "selector": "name:HomeMeditationHero",
        "property": "source_pose",
        "operator": "equals",
        "expected": "meditation"
      }
    },
    {
      "name": "Home meditation animation is live",
      "action": "assert_property",
      "with": {
        "selector": "name:HomeMeditationHero",
        "property": "runtime_animation_ready",
        "operator": "equals",
        "expected": true
      }
    },
    {
      "name": "Home defaults to cultivation presentation mode",
      "action": "assert_property",
      "with": {
        "selector": "name:HomeMeditationHero",
        "property": "home_mode",
        "operator": "equals",
        "expected": "cultivation"
      }
    },
    {
      "name": "Home HUD exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:HomeHUD",
        "state": "exists",
        "timeout_ms": 15000
      }
    },
    {
      "name": "Rest mode control exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:RestModeButton",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Switch Home to rest presentation",
      "action": "click",
      "with": {
        "selector": "name:RestModeButton"
      }
    },
    {
      "name": "Hero enters rest presentation mode",
      "action": "assert_property",
      "with": {
        "selector": "name:HomeMeditationHero",
        "property": "home_mode",
        "operator": "equals",
        "expected": "rest"
      }
    },
    {
      "name": "Switch Home back to cultivation presentation",
      "action": "click",
      "with": {
        "selector": "name:CultivationModeButton"
      }
    },
    {
      "name": "Hero returns to cultivation presentation mode",
      "action": "assert_property",
      "with": {
        "selector": "name:HomeMeditationHero",
        "property": "home_mode",
        "operator": "equals",
        "expected": "cultivation"
      }
    },
    {
      "name": "Canonical bridge reaches ONLINE",
      "action": "wait_for_property",
      "with": {
        "selector": "name:BridgeStatus",
        "property": "text",
        "operator": "contains",
        "expected_value": "ONLINE",
        "timeout_ms": 20000,
        "poll_interval_ms": 200
      }
    },
    {
      "name": "Realm text is populated",
      "action": "assert_property",
      "with": {
        "selector": "name:RealmLabel",
        "property": "text",
        "operator": "not_equals",
        "expected": ""
      }
    },
    {
      "name": "Cultivation contract is usable",
      "action": "assert_property",
      "with": {
        "selector": "name:CultivationProgress",
        "property": "max_value",
        "operator": "greater_than",
        "expected": 0
      }
    },
    {
      "name": "Cultivation event layer exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:CultivationEvent",
        "state": "exists",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Cultivation display has per-second rate",
      "action": "assert_property",
      "with": {
        "selector": "name:HomeHUD",
        "property": "display_rate_per_second",
        "operator": "greater_than",
        "expected": 0
      }
    },
    {
      "name": "Cultivation rate label uses player-facing per-second cadence",
      "action": "assert_property",
      "with": {
        "selector": "name:CultivationRate",
        "property": "text",
        "operator": "contains",
        "expected": "/s"
      }
    },
    {
      "name": "Open current-life sheet",
      "action": "click",
      "with": {
        "selector": "name:IdentityTap"
      }
    },
    {
      "name": "Progressive-disclosure sheet appears",
      "action": "wait_for_node",
      "with": {
        "selector": "name:ActiveSheet",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Close current-life sheet",
      "action": "click",
      "with": {
        "selector": "name:HomeSheetClose"
      }
    },
    {
      "name": "Current-life sheet is fully dismissed",
      "action": "wait_for_node",
      "with": {
        "selector": "name:ActiveSheet",
        "state": "removed",
        "timeout_ms": 3000,
        "poll_interval_ms": 25
      }
    },
    {
      "name": "Unported Phap Bao nav is disabled",
      "action": "assert_property",
      "with": {
        "selector": "name:Nav_artifacts",
        "property": "disabled",
        "operator": "equals",
        "expected": true
      }
    },
    {
      "name": "Unported Linh Thu nav is disabled",
      "action": "assert_property",
      "with": {
        "selector": "name:Nav_pets",
        "property": "disabled",
        "operator": "equals",
        "expected": true
      }
    },
    {
      "name": "Unported World nav is disabled",
      "action": "assert_property",
      "with": {
        "selector": "name:Nav_world",
        "property": "disabled",
        "operator": "equals",
        "expected": true
      }
    },
    {
      "name": "Unported Faction nav is disabled",
      "action": "assert_property",
      "with": {
        "selector": "name:Nav_faction",
        "property": "disabled",
        "operator": "equals",
        "expected": true
      }
    },
    {
      "name": "Unported Combat quick action is disabled",
      "action": "assert_property",
      "with": {
        "selector": "name:CombatAction",
        "property": "disabled",
        "operator": "equals",
        "expected": true
      }
    },
    {
      "name": "Home Character quick action opens Character",
      "action": "click",
      "with": {
        "selector": "name:CharacterAction"
      }
    },
    {
      "name": "Character screen opens from Home action",
      "action": "wait_for_node",
      "with": {
        "selector": "name:CharacterScreen",
        "state": "visible",
        "timeout_ms": 15000
      }
    },
    {
      "name": "Return Home using dock",
      "action": "click",
      "with": {
        "selector": "name:Nav_home"
      }
    },
    {
      "name": "Home stage returns",
      "action": "wait_for_node",
      "with": {
        "selector": "name:HomeStage",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Linh Can shortcut opens Character profile",
      "action": "click",
      "with": {
        "selector": "name:RootAction"
      }
    },
    {
      "name": "Profile sheet appears from Linh Can shortcut",
      "action": "wait_for_property",
      "with": {
        "selector": "name:CharacterDetailTitle",
        "property": "text",
        "operator": "contains",
        "expected_value": "Hồ Sơ",
        "timeout_ms": 15000,
        "poll_interval_ms": 200
      }
    },
    {
      "name": "Scene tree remains inspectable",
      "action": "tree",
      "with": {
        "root_path": "/root",
        "max_depth": 5
      }
    }
  ]
}
