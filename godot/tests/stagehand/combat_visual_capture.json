{
  "name": "tutien-combat-visual-capture",
  "description": "Actual canonical Artifact seven-slot reference: isolated QA realm progression, canonical learning/loadout/Auto, real Boss fight; no fabricated resource, readiness or result.",
  "target": {
    "mode": "launch",
    "project_path": "../..",
    "headless": false,
    "timeout_ms": 60000
  },
  "steps": [
    {
      "name": "Home runtime starts",
      "action": "wait_for_node",
      "with": {
        "selector": "name:HomeHUD",
        "state": "visible",
        "timeout_ms": 15000
      }
    },
    {
      "name": "Canonical bridge reaches online",
      "action": "wait_for_property",
      "with": {
        "selector": "name:BridgeStatus",
        "property": "text",
        "operator": "contains",
        "expected_value": "ONLINE",
        "timeout_ms": 20000,
        "poll_interval_ms": 200
      }
    },
    {
      "with": {
        "key": "F9"
      },
      "name": "Prepare real canonical Artifact full loadout",
      "action": "press_key"
    },
    {
      "with": {
        "selector": "name:CombatDaoTitle",
        "operator": "equals",
        "timeout_ms": 15000,
        "expected_value": "NGỰ KHÍ",
        "property": "text"
      },
      "name": "Artifact DTO reaches compact widget",
      "action": "wait_for_property"
    },
    {
      "with": {
        "selector": "name:CombatActive5",
        "operator": "contains",
        "timeout_ms": 15000,
        "expected_value": "Trấn",
        "property": "tooltip_text"
      },
      "name": "Fifth active slot has canonical skill",
      "action": "wait_for_property"
    },
    {
      "name": "Capture Combat prefight 390x844",
      "with": {
        "output": "combat-prefight-390x844.png"
      },
      "action": "screenshot"
    },
    {
      "with": {
        "value": {
          "x": 360,
          "y": 800
        },
        "selector": "/root",
        "property": "size"
      },
      "action": "set_property",
      "name": "Resize size to 360x800"
    },
    {
      "with": {
        "value": {
          "x": 360,
          "y": 800
        },
        "selector": "/root",
        "property": "content_scale_size"
      },
      "action": "set_property",
      "name": "Resize content_scale_size to 360x800"
    },
    {
      "with": {
        "duration_ms": 200
      },
      "action": "sleep",
      "name": "Settle responsive containers"
    },
    {
      "with": {
        "output": "combat-prefight-360x800.png"
      },
      "action": "screenshot",
      "name": "Capture prefight 360x800"
    },
    {
      "with": {
        "value": {
          "x": 412,
          "y": 915
        },
        "selector": "/root",
        "property": "size"
      },
      "action": "set_property",
      "name": "Resize size to 412x915"
    },
    {
      "with": {
        "value": {
          "x": 412,
          "y": 915
        },
        "selector": "/root",
        "property": "content_scale_size"
      },
      "action": "set_property",
      "name": "Resize content_scale_size to 412x915"
    },
    {
      "with": {
        "duration_ms": 200
      },
      "action": "sleep",
      "name": "Settle responsive containers"
    },
    {
      "with": {
        "output": "combat-prefight-412x915.png"
      },
      "action": "screenshot",
      "name": "Capture prefight 412x915"
    },
    {
      "with": {
        "value": {
          "x": 430,
          "y": 932
        },
        "selector": "/root",
        "property": "size"
      },
      "action": "set_property",
      "name": "Resize size to 430x932"
    },
    {
      "with": {
        "value": {
          "x": 430,
          "y": 932
        },
        "selector": "/root",
        "property": "content_scale_size"
      },
      "action": "set_property",
      "name": "Resize content_scale_size to 430x932"
    },
    {
      "with": {
        "duration_ms": 200
      },
      "action": "sleep",
      "name": "Settle responsive containers"
    },
    {
      "with": {
        "output": "combat-prefight-430x932.png"
      },
      "action": "screenshot",
      "name": "Capture prefight 430x932"
    },
    {
      "with": {
        "value": {
          "x": 390,
          "y": 844
        },
        "selector": "/root",
        "property": "size"
      },
      "action": "set_property",
      "name": "Restore size to 390x844"
    },
    {
      "with": {
        "value": {
          "x": 390,
          "y": 844
        },
        "selector": "/root",
        "property": "content_scale_size"
      },
      "action": "set_property",
      "name": "Restore content_scale_size to 390x844"
    },
    {
      "with": {
        "duration_ms": 200
      },
      "action": "sleep",
      "name": "Settle reference layout"
    },
    {
      "name": "Focus game",
      "action": "focus_window",
      "with": {
        "selector": "/root"
      }
    },
    {
      "name": "Focus Back",
      "action": "press_key",
      "with": {
        "key": "Tab"
      }
    },
    {
      "name": "Key release",
      "action": "sleep",
      "with": {
        "duration_ms": 150
      }
    },
    {
      "name": "Focus Challenge",
      "action": "press_key",
      "with": {
        "key": "Tab"
      }
    },
    {
      "name": "Key release",
      "action": "sleep",
      "with": {
        "duration_ms": 150
      }
    },
    {
      "name": "Activate real Challenge",
      "action": "press_key",
      "with": {
        "key": "Space"
      }
    },
    {
      "name": "Canonical event playback reaches tactical lane",
      "action": "wait_for_property",
      "with": {
        "selector": "name:CombatTacticalLane",
        "property": "text",
        "operator": "not_equals",
        "expected_value": "CHỜ GIAO TRANH",
        "timeout_ms": 15000,
        "poll_interval_ms": 100
      }
    },
    {
      "name": "Let canonical playback advance",
      "with": {
        "duration_ms": 2000
      },
      "action": "sleep"
    },
    {
      "name": "Capture Combat playback 390x844",
      "with": {
        "output": "combat-playback-390x844.png"
      },
      "action": "screenshot"
    },
    {
      "with": {
        "key": "Tab"
      },
      "action": "press_key",
      "name": "Focus Back after playback"
    },
    {
      "with": {
        "duration_ms": 150
      },
      "action": "sleep",
      "name": "Release navigation key"
    },
    {
      "with": {
        "key": "Space"
      },
      "action": "press_key",
      "name": "Return Home using real Back button"
    },
    {
      "with": {
        "timeout_ms": 5000,
        "selector": "name:HomeStage",
        "state": "visible"
      },
      "action": "wait_for_node",
      "name": "Home returns after Combat"
    },
    {
      "with": {
        "root_path": "/root",
        "max_depth": 5
      },
      "action": "tree",
      "name": "Scene tree remains inspectable"
    }
  ]
}
