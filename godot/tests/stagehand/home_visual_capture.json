{
  "name": "tutien-home-visual-capture",
  "description": "Capture deterministic production Home components at 390x844 in the dense canonical-ready presentation state. Capture-only until explicit user approval.",
  "target": {
    "mode": "launch",
    "project_path": "../..",
    "headless": false,
    "timeout_ms": 60000
  },
  "steps": [
    {
      "name": "Switch to deterministic Home visual harness",
      "action": "change_scene",
      "with": {
        "scene_path": "res://tests/visual/home_visual_harness.tscn"
      }
    },
    {
      "name": "Home visual harness is visible",
      "action": "wait_for_node",
      "with": {
        "selector": "name:HomeVisualHarness",
        "state": "visible",
        "timeout_ms": 10000
      }
    },
    {
      "name": "Home HUD is rendered",
      "action": "wait_for_node",
      "with": {
        "selector": "name:HomeHUD",
        "state": "visible",
        "timeout_ms": 10000
      }
    },
    {
      "name": "Visual fixture is marked online",
      "action": "assert_property",
      "with": {
        "selector": "name:BridgeStatus",
        "property": "text",
        "operator": "contains",
        "expected": "ONLINE"
      }
    },
    {
      "name": "Cultivation bar is populated",
      "action": "assert_property",
      "with": {
        "selector": "name:CultivationProgress",
        "property": "value",
        "operator": "greater_than",
        "expected": 0
      }
    },
    {
      "name": "Advancement CTA is visible in dense fixture",
      "action": "wait_for_node",
      "with": {
        "selector": "name:PrimaryCTA",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Retreat orb is retained in Home action band",
      "action": "wait_for_node",
      "with": {
        "selector": "name:RetreatButton",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Let render settle",
      "action": "sleep",
      "with": {
        "duration_ms": 250
      }
    },
    {
      "name": "Capture deterministic Home 390x844",
      "action": "screenshot",
      "with": {
        "output": "home-390x844.png"
      }
    }
  ]
}
