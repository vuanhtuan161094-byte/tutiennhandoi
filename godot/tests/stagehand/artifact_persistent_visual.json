      "with": {
        "output": "artifact-idle-3-390x844.png"
      }
    },
    {
      "name": "Select fixture guard",
      "action": "press_key",
      "with": {
        "key": "G"
      }
    },
    {
      "name": "Settle guard",
      "action": "sleep",
