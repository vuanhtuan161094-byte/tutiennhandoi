      "action": "wait_for_property",
      "with": { "selector": "name:CombatDaoTitle", "property": "text", "operator": "equals", "expected_value": "ĐỘC ĐẠO", "timeout_ms": 30000, "poll_interval_ms": 100 }
    },
    {
      "name": "Capture canonical Độc widget",
      "action": "screenshot",
      "with": { "output": "dao-poison-390x844.png" }
    },
    {
      "name": "Advance to Trận fixture",
      "action": "press_key",
      "with": { "key": "F11" }
    },
    {
      "name": "Trận fixture action starts",
      "action": "wait_for_property",
      "with": { "selector": "name:BackendBridge", "property": "_action_inflight", "operator": "equals", "expected_value": true, "timeout_ms": 5000, "poll_interval_ms": 50 }
    },
    {
      "name": "Trận fixture action completes",
      "action": "wait_for_property",
      "with": { "selector": "name:BackendBridge", "property": "_action_inflight", "operator": "equals", "expected_value": false, "timeout_ms": 30000, "poll_interval_ms": 100 }
    },
    {
      "name": "Trận projection is active",
      "action": "wait_for_property",
      "with": { "selector": "name:CombatDaoTitle", "property": "text", "operator": "equals", "expected_value": "TRẬN ĐẠO", "timeout_ms": 30000, "poll_interval_ms": 100 }
    },
    {
      "name": "Capture canonical Trận widget",
      "action": "screenshot",
      "with": { "output": "dao-formation-390x844.png" }
    },
    {
      "name": "Advance to Ngự Khí fixture",
      "action": "press_key",
      "with": { "key": "F11" }
    },
    {
      "name": "Ngự Khí fixture action starts",
      "action": "wait_for_property",
      "with": { "selector": "name:BackendBridge", "property": "_action_inflight", "operator": "equals", "expected_value": true, "timeout_ms": 5000, "poll_interval_ms": 50 }
    },
    {
      "name": "Ngự Khí fixture action completes",
      "action": "wait_for_property",
      "with": { "selector": "name:BackendBridge", "property": "_action_inflight", "operator": "equals", "expected_value": false, "timeout_ms": 30000, "poll_interval_ms": 100 }
    },
    {
      "name": "Ngự Khí projection is active",
      "action": "wait_for_property",
      "with": { "selector": "name:CombatDaoTitle", "property": "text", "operator": "equals", "expected_value": "NGỰ KHÍ", "timeout_ms": 30000, "poll_interval_ms": 100 }
    },
    {
      "name": "Capture canonical Ngự Khí widget",
      "action": "screenshot",
      "with": { "output": "dao-artifact-390x844.png" }
    },
    {
      "name": "Advance to Thần Niệm fixture",
      "action": "press_key",
