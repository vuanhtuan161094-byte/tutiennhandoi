    },
    {
      "name": "Thần Niệm projection is active",
      "action": "wait_for_property",
      "with": { "selector": "name:CombatDaoTitle", "property": "text", "operator": "equals", "expected_value": "THẦN NIỆM", "timeout_ms": 30000, "poll_interval_ms": 100 }
    },
    {
      "name": "Capture canonical Thần Niệm widget",
      "action": "screenshot",
      "with": { "output": "dao-mind-390x844.png" }
    }
  ]
