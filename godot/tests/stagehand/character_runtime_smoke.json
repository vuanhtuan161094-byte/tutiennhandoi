{
  "name": "tutien-character-runtime-smoke",
  "description": "Launch the real Godot client, route from Home into Character and prove canonical Character transport + 10-slot presentation exists.",
  "target": {"mode": "launch", "project_path": "../..", "headless": true, "timeout_ms": 60000},
  "steps": [
    {"name":"Home route starts","action":"wait_for_node","with":{"selector":"name:Nav_character","state":"exists","timeout_ms":15000}},
    {"name":"Open Character","action":"click","with":{"selector":"name:Nav_character"}},
    {"name":"Character screen appears","action":"wait_for_node","with":{"selector":"name:CharacterScreen","state":"visible","timeout_ms":15000}},
    {"name":"Character identity is populated","action":"assert_property","with":{"selector":"name:CharacterName","property":"text","operator":"not_equals","expected":""}},
    {"name":"Weapon slot exists","action":"wait_for_node","with":{"selector":"name:CharacterSlot_weapon","state":"visible","timeout_ms":5000}},
    {"name":"Talisman slot exists","action":"wait_for_node","with":{"selector":"name:CharacterSlot_talisman","state":"visible","timeout_ms":5000}},
    {"name":"Potential CTA exists","action":"wait_for_node","with":{"selector":"name:CharacterPotentialCTA","state":"visible","timeout_ms":5000}}
  ]
}
