{
  "name": "tutien-character-runtime-smoke",
  "description": "Launch the real Godot client, route into Character, verify progressive-disclosure Tĩnh/Động/Ẩn controls, eleven animation presets, lazy loading, and canonical 10-slot presentation.",
  "target": {
    "mode": "launch",
    "project_path": "../..",
    "headless": true,
    "timeout_ms": 60000
  },
  "steps": [
    {
      "name": "Home route starts",
      "action": "wait_for_node",
      "with": {
        "selector": "name:Nav_character",
        "state": "exists",
        "timeout_ms": 15000
      }
    },
    {
      "name": "Open Character",
      "action": "click",
      "with": {
        "selector": "name:Nav_character"
      }
    },
    {
      "name": "Character screen appears",
      "action": "wait_for_node",
      "with": {
        "selector": "name:CharacterScreen",
        "state": "visible",
        "timeout_ms": 15000
      }
    },
    {
      "name": "Character identity is populated",
      "action": "assert_property",
      "with": {
        "selector": "name:CharacterName",
        "property": "text",
        "operator": "not_equals",
        "expected": ""
      }
    },
    {
      "name": "Character hero defaults to static presentation",
      "action": "assert_property",
      "with": {
        "selector": "name:CharacterHero",
        "property": "motion_mode",
        "operator": "equals",
        "expected": "still"
      }
    },
    {
      "name": "Character hero runtime is ready in static mode",
      "action": "assert_property",
      "with": {
        "selector": "name:CharacterHero",
        "property": "runtime_animation_ready",
        "operator": "equals",
        "expected": true
      }
    },
    {
      "name": "Character presentation entry point exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:CharacterPresentationButton",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Open Character presentation controls",
      "action": "click",
      "with": {
        "selector": "name:CharacterPresentationButton"
      }
    },
    {
      "name": "Character presentation panel appears",
      "action": "wait_for_node",
      "with": {
        "selector": "name:CharacterPresentationPanel",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Character eleven preset option exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:CharacterPreset_character_motion_11",
        "state": "exists",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Switch Character to animated mode",
      "action": "click",
      "with": {
        "selector": "name:CharacterAnimatedButton"
      }
    },
    {
      "name": "Character hero enters animated mode",
      "action": "wait_for_property",
      "with": {
        "selector": "name:CharacterHero",
        "property": "motion_mode",
        "operator": "equals",
        "expected_value": "animated",
        "timeout_ms": 3000,
        "poll_interval_ms": 25
      }
    },
    {
      "name": "Character selected preset loads on demand",
      "action": "wait_for_property",
      "with": {
        "selector": "name:CharacterHero",
        "property": "animation_source",
        "operator": "equals",
        "expected_value": "video_spriteframes_v2_green",
        "timeout_ms": 12000,
        "poll_interval_ms": 100
      }
    },
    {
      "name": "Character hero uses video state",
      "action": "assert_property",
      "with": {
        "selector": "name:CharacterHero",
        "property": "animation_mode",
        "operator": "equals",
        "expected": "standing_video"
      }
    },
    {
      "name": "Hide Character hero",
      "action": "click",
      "with": {
        "selector": "name:CharacterHiddenButton"
      }
    },
    {
      "name": "Character hero enters hidden mode",
      "action": "wait_for_property",
      "with": {
        "selector": "name:CharacterHero",
        "property": "motion_mode",
        "operator": "equals",
        "expected_value": "hidden",
        "timeout_ms": 2000,
        "poll_interval_ms": 25
      }
    },
    {
      "name": "Restore Character hero as static",
      "action": "click",
      "with": {
        "selector": "name:CharacterStillButton"
      }
    },
    {
      "name": "Character hero returns to static mode",
      "action": "wait_for_property",
      "with": {
        "selector": "name:CharacterHero",
        "property": "motion_mode",
        "operator": "equals",
        "expected_value": "still",
        "timeout_ms": 2000,
        "poll_interval_ms": 25
      }
    },
    {
      "name": "Character presentation profile is current",
      "action": "assert_property",
      "with": {
        "selector": "name:CharacterHero",
        "property": "animation_profile",
        "operator": "equals",
        "expected": "character_standing_v3_options"
      }
    },
    {
      "name": "Character route owns presentation lifecycle",
      "action": "assert_property",
      "with": {
        "selector": "name:CharacterHero",
        "property": "presentation_active",
        "operator": "equals",
        "expected": true
      }
    },
    {
      "name": "Close Character presentation controls",
      "action": "click",
      "with": {
        "selector": "name:CharacterPresentationClose"
      }
    },
    {
      "name": "Weapon slot exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:CharacterSlot_weapon",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Weapon slot has production icon",
      "action": "assert_property",
      "with": {
        "selector": "name:CharacterSlot_weapon",
        "property": "icon_ready",
        "operator": "equals",
        "expected": true
      }
    },
    {
      "name": "Talisman slot has production icon",
      "action": "assert_property",
      "with": {
        "selector": "name:CharacterSlot_talisman",
        "property": "icon_ready",
        "operator": "equals",
        "expected": true
      }
    },
    {
      "name": "Talisman slot exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:CharacterSlot_talisman",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Potential CTA exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:CharacterPotentialCTA",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Open inventory",
      "action": "click",
      "with": {
        "selector": "name:CharacterAction_equipment"
      }
    },
    {
      "name": "Inventory screen appears",
      "action": "wait_for_node",
      "with": {
        "selector": "name:EquipmentInventoryScreen",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Inventory title is canonical",
      "action": "assert_property",
      "with": {
        "selector": "name:InventoryTitle",
        "property": "text",
        "operator": "contains",
        "expected": "Kho Đồ"
      }
    },
    {
      "name": "Inventory resource strip exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:InventoryResources",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Inventory set tab exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:InventoryTab_sets",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Inventory materials tab exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:InventoryTab_materials",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Inventory forge tab exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:InventoryTab_forge",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Close inventory",
      "action": "click",
      "with": {
        "selector": "name:InventoryClose"
      }
    },
    {
      "name": "Inventory is fully dismissed",
      "action": "wait_for_property",
      "with": {
        "selector": "name:EquipmentInventoryScreen",
        "property": "visible",
        "operator": "equals",
        "expected_value": false,
        "timeout_ms": 3000,
        "poll_interval_ms": 25
      }
    },
    {
      "name": "Weapon slot opens focused inventory flow",
      "action": "click",
      "with": {
        "selector": "name:CharacterSlot_weapon"
      }
    },
    {
      "name": "Focused inventory subtitle names slot",
      "action": "wait_for_property",
      "with": {
        "selector": "name:InventorySubtitle",
        "property": "text",
        "operator": "contains",
        "expected_value": "Đạo Binh",
        "timeout_ms": 5000,
        "poll_interval_ms": 100
      }
    },
    {
      "name": "Close focused inventory flow",
      "action": "click",
      "with": {
        "selector": "name:InventoryClose"
      }
    },
    {
      "name": "Focused inventory is fully dismissed",
      "action": "wait_for_property",
      "with": {
        "selector": "name:EquipmentInventoryScreen",
        "property": "visible",
        "operator": "equals",
        "expected_value": false,
        "timeout_ms": 3000,
        "poll_interval_ms": 25
      }
    },
    {
      "name": "Open stats detail",
      "action": "click",
      "with": {
        "selector": "name:CharacterAction_stats"
      }
    },
    {
      "name": "Stats title is canonical",
      "action": "wait_for_property",
      "with": {
        "selector": "name:CharacterDetailTitle",
        "property": "text",
        "operator": "contains",
        "expected_value": "Thuộc Tính",
        "timeout_ms": 3000,
        "poll_interval_ms": 25
      }
    },
    {
      "name": "Close stats detail",
      "action": "click",
      "with": {
        "selector": "name:CharacterDetailClose"
      }
    },
    {
      "name": "Stats detail is fully dismissed",
      "action": "wait_for_property",
      "with": {
        "selector": "name:CharacterDetailSheet",
        "property": "visible",
        "operator": "equals",
        "expected_value": false,
        "timeout_ms": 3000,
        "poll_interval_ms": 25
      }
    },
    {
      "name": "Open profile detail",
      "action": "click",
      "with": {
        "selector": "name:CharacterAction_profile"
      }
    },
    {
      "name": "Profile title is canonical",
      "action": "wait_for_property",
      "with": {
        "selector": "name:CharacterDetailTitle",
        "property": "text",
        "operator": "contains",
        "expected_value": "Hồ Sơ",
        "timeout_ms": 3000,
        "poll_interval_ms": 25
      }
    },
    {
      "name": "Profile bloodline tab exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:ProfileTab_blood",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Close profile detail",
      "action": "click",
      "with": {
        "selector": "name:CharacterDetailClose"
      }
    },
    {
      "name": "Profile detail is fully dismissed",
      "action": "wait_for_property",
      "with": {
        "selector": "name:CharacterDetailSheet",
        "property": "visible",
        "operator": "equals",
        "expected_value": false,
        "timeout_ms": 3000,
        "poll_interval_ms": 25
      }
    },
    {
      "name": "Open potential allocation",
      "action": "click",
      "with": {
        "selector": "name:CharacterPotentialCTA"
      }
    },
    {
      "name": "Potential title appears",
      "action": "wait_for_property",
      "with": {
        "selector": "name:CharacterDetailTitle",
        "property": "text",
        "operator": "contains",
        "expected_value": "Tăng Điểm",
        "timeout_ms": 3000,
        "poll_interval_ms": 25
      }
    },
    {
      "name": "Potential +1 exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:Potential_power_1",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Potential +5 exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:Potential_power_5",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Potential +10 exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:Potential_power_10",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Potential +100 exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:Potential_power_100",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Potential all exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:Potential_power_all",
        "state": "visible",
        "timeout_ms": 5000
      }
    }
  ]
}
