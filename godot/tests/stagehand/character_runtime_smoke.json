{
  "name": "tutien-character-runtime-smoke",
  "description": "Launch the real Godot client, route from Home into Character and prove canonical Character transport + 10-slot presentation exists.",
  "target": {
    "mode": "launch",
    "project_path": "../..",
    "headless": true,
    "timeout_ms": 60000
  },
  "steps": [
    {
      "name": "Home route starts",
      "action": "wait_for_node",
      "with": {
        "selector": "name:Nav_character",
        "state": "exists",
        "timeout_ms": 15000
      }
    },
    {
      "name": "Open Character",
      "action": "click",
      "with": {
        "selector": "name:Nav_character"
      }
    },
    {
      "name": "Character screen appears",
      "action": "wait_for_node",
      "with": {
        "selector": "name:CharacterScreen",
        "state": "visible",
        "timeout_ms": 15000
      }
    },
    {
      "name": "Character identity is populated",
      "action": "assert_property",
      "with": {
        "selector": "name:CharacterName",
        "property": "text",
        "operator": "not_equals",
        "expected": ""
      }
    },
    {
      "name": "Standing hero is animated",
      "action": "assert_property",
      "with": {
        "selector": "name:CharacterHero",
        "property": "runtime_animation_ready",
        "operator": "equals",
        "expected": true
      }
    },
    {
      "name": "Standing hero selected a production animation source",
      "action": "assert_property",
      "with": {
        "selector": "name:CharacterHero",
        "property": "animation_source",
        "operator": "not_equals",
        "expected": "none"
      }
    },
    {
      "name": "Standing hero uses Character production animation profile",
      "action": "assert_property",
      "with": {
        "selector": "name:CharacterHero",
        "property": "animation_profile",
        "operator": "equals",
        "expected": "character_standing_v1"
      }
    },
    {
      "name": "Standing hero uses standing pose",
      "action": "assert_property",
      "with": {
        "selector": "name:CharacterHero",
        "property": "source_pose",
        "operator": "equals",
        "expected": "standing"
      }
    },
    {
      "name": "Standing hero uses standing idle state",
      "action": "assert_property",
      "with": {
        "selector": "name:CharacterHero",
        "property": "animation_mode",
        "operator": "equals",
        "expected": "standing_idle"
      }
    },
    {
      "name": "Weapon slot exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:CharacterSlot_weapon",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Weapon slot has production icon",
      "action": "assert_property",
      "with": {
        "selector": "name:CharacterSlot_weapon",
        "property": "icon_ready",
        "operator": "equals",
        "expected": true
      }
    },
    {
      "name": "Talisman slot has production icon",
      "action": "assert_property",
      "with": {
        "selector": "name:CharacterSlot_talisman",
        "property": "icon_ready",
        "operator": "equals",
        "expected": true
      }
    },
    {
      "name": "Talisman slot exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:CharacterSlot_talisman",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Potential CTA exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:CharacterPotentialCTA",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Open inventory",
      "action": "click",
      "with": {
        "selector": "name:CharacterAction_equipment"
      }
    },
    {
      "name": "Inventory screen appears",
      "action": "wait_for_node",
      "with": {
        "selector": "name:EquipmentInventoryScreen",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Inventory title is canonical",
      "action": "assert_property",
      "with": {
        "selector": "name:InventoryTitle",
        "property": "text",
        "operator": "contains",
        "expected": "Kho Đồ"
      }
    },
    {
      "name": "Inventory resource strip exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:InventoryResources",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Inventory set tab exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:InventoryTab_sets",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Inventory materials tab exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:InventoryTab_materials",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Close inventory",
      "action": "click",
      "with": {
        "selector": "name:InventoryClose"
      }
    },
    {
      "name": "Weapon slot opens focused inventory flow",
      "action": "click",
      "with": {
        "selector": "name:CharacterSlot_weapon"
      }
    },
    {
      "name": "Focused inventory subtitle names slot",
      "action": "wait_for_property",
      "with": {
        "selector": "name:InventorySubtitle",
        "property": "text",
        "operator": "contains",
        "expected_value": "Đạo Binh",
        "timeout_ms": 5000,
        "poll_interval_ms": 100
      }
    },
    {
      "name": "Close focused inventory flow",
      "action": "click",
      "with": {
        "selector": "name:InventoryClose"
      }
    },
    {
      "name": "Open stats detail",
      "action": "click",
      "with": {
        "selector": "name:CharacterAction_stats"
      }
    },
    {
      "name": "Stats title is canonical",
      "action": "assert_property",
      "with": {
        "selector": "name:CharacterDetailTitle",
        "property": "text",
        "operator": "contains",
        "expected": "Thuộc Tính"
      }
    },
    {
      "name": "Close stats detail",
      "action": "click",
      "with": {
        "selector": "name:CharacterDetailClose"
      }
    },
    {
      "name": "Open profile detail",
      "action": "click",
      "with": {
        "selector": "name:CharacterAction_profile"
      }
    },
    {
      "name": "Profile title is canonical",
      "action": "assert_property",
      "with": {
        "selector": "name:CharacterDetailTitle",
        "property": "text",
        "operator": "contains",
        "expected": "Hồ Sơ"
      }
    },
    {
      "name": "Profile bloodline tab exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:ProfileTab_blood",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Close profile detail",
      "action": "click",
      "with": {
        "selector": "name:CharacterDetailClose"
      }
    },
    {
      "name": "Open potential allocation",
      "action": "click",
      "with": {
        "selector": "name:CharacterPotentialCTA"
      }
    },
    {
      "name": "Potential title appears",
      "action": "assert_property",
      "with": {
        "selector": "name:CharacterDetailTitle",
        "property": "text",
        "operator": "contains",
        "expected": "Tăng Điểm"
      }
    },
    {
      "name": "Potential +1 exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:Potential_power_1",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Potential +5 exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:Potential_power_5",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Potential +10 exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:Potential_power_10",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Potential +100 exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:Potential_power_100",
        "state": "visible",
        "timeout_ms": 5000
      }
    },
    {
      "name": "Potential all exists",
      "action": "wait_for_node",
      "with": {
        "selector": "name:Potential_power_all",
        "state": "visible",
        "timeout_ms": 5000
      }
    }
  ]
}
